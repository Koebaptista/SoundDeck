# Copie para `.env.local` quando o backend Django existir.
#
# Sem estas variáveis o deck roda no repositório de mock (localStorage +
# IndexedDB), com o roteiro de exemplo e os áudios sintéticos de `public/audio`.

# `api` liga o cliente HTTP do Django. Qualquer outro valor mantém o mock.
VITE_DATA=api

# Onde o Django está servindo. Precisa liberar CORS para a origem do Vite.
VITE_API_URL=http://127.0.0.1:8000
