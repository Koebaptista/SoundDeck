# Copie para `.env`. Sem ele o backend roda com os padrões de
# desenvolvimento: SQLite ao lado do manage.py e CORS liberado para o Vite.

# Assina mensagens internas. Só importa se o servidor sair da máquina local.
DJANGO_SECRET_KEY=troque-por-qualquer-coisa-longa

# `False` no computador que vai subir ao palco: erro vira 500 limpo, não uma
# página de traceback no meio da peça.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Origem do Vite. O engine de áudio carrega os arquivos com
# `crossOrigin="anonymous"`, então precisa estar liberada aqui.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Quanto tempo (segundos) um áudio removido fica no disco esperando o
# "Desfazer". Bem maior que os 12s do aviso, de propósito.
SOUNDDECK_UNDO_WINDOW=3600

# Opcional: um Postgres já existente no lugar do SQLite.
# DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/sounddeck

# Onde ficam o banco e a pasta `media/`. Vazio significa "ao lado do
# manage.py", que é o que o desenvolvimento e o Docker querem. Quem preenche
# isto é o aplicativo de mesa, apontando para a pasta do usuário — o código
# instalado fica num lugar que o Windows não deixa escrever.
# SOUNDDECK_DATA=

# A porta do servidor quando ele roda como `server.py`, fora do `runserver`.
# O aplicativo de mesa sorteia uma livre a cada abertura e preenche sozinho.
# SOUNDDECK_PORT=8000
